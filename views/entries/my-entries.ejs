<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Entries</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <h1>My Entries</h1>

    <% for(let oneEntry of entries){ %>
        <h3><%= oneEntry.title %></h3>
        <p><%= oneEntry.entryBody %></p>
        <p>Public: <%= oneEntry.isPublic %></p>

        <form action="/entries/<%= oneEntry._id %>?_method=DELETE" method="post">
            <button>Delete Entry</button>
        </form>

        <a href="/entries/<%= oneEntry._id %>/edit">Edit Entry</a>
    <% } %>
  </body>
</html>
