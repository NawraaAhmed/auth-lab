<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Entry</title>
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <h1>Edit Entry</h1>

    <form action="/entries/<%= entry._id %>?_method=PUT" method="post">
      <label for="title">Title:</label>
      <input value="<%= entry.title %>" name="title" id="title" type="text" />

      <label for="entryBody">Entry:</label>
      <textarea name="entryBody" id="entryBody"><%= entry.entryBody %></textarea>

      <label for="isPublic">Make Public?</label>
      <input <% if(entry.isPublic){ %> checked <% } %> name="isPublic" id="isPublic" type="checkbox" />

      <button type="submit">Update Entry</button>
    </form>
  </body>
</html>
